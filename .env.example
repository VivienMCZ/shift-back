# Copier ce fichier vers .env et renseigner les valeurs.
# .env est ignoré par git : aucun secret réel ne doit être versionné.

# --- Base de données --------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changez-moi
POSTGRES_DB=postgres
POSTGRES_HOST_PORT=5432
DATABASE_URL=postgresql://postgres:changez-moi@localhost:5432/postgres
DB_INIT_RETRIES=5
DB_INIT_RETRY_DELAY_SECONDS=2
# Pool de connexions SQLAlchemy. Les routes étant synchrones, uvicorn les
# exécute dans un pool de threads : en dessous de ~40 connexions cumulées
# (pool + débordement), des requêtes attendent une connexion sous charge.
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800

# --- Sécurité ---------------------------------------------------------------
# Clé de signature des jetons de session. 32 caractères minimum (HS256).
# Générer avec :  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRATION_DAYS=7

# Jeton requis dans l'en-tête X-Admin-Token pour créer/modifier/supprimer un
# libellé (/api/v1/libs). Vide = toute écriture est refusée.
# Générer avec :  python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_TOKEN=

# Passer COOKIE_SECURE à true dès que l'API est servie en HTTPS (obligatoire en
# production). COOKIE_SAMESITE=none impose COOKIE_SECURE=true côté navigateur.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Origines autorisées par CORS, séparées par des virgules.
# Vide = valeurs par défaut de développement (localhost:3000/3001).
CORS_ORIGINS=
CORS_ORIGIN_REGEX=

# Exposition de /docs, /redoc et /openapi.json. À passer à false en production.
ENABLE_DOCS=true

# --- Géocodage ---------------------------------------------------------------
# Base Adresse Nationale servie par la Géoplateforme (IGN).
# Vide = https://data.geopf.fr/geocodage. L'ancienne adresse
# api-adresse.data.gouv.fr est en fin de vie (en-tête Sunset au 31/01/2026).
ADRESSE_API_URL=
# Mémorisation des réponses de géocodage. L'amont plafonne à 1 requête/seconde
# pour l'ensemble du site (le quota porte sur l'IP du serveur, pas sur le
# visiteur) : sans cache, l'autocomplétion prend des 429 dès quelques
# utilisateurs simultanés.
GEOCODE_CACHE_ENABLED=true
GEOCODE_CACHE_TTL_SECONDS=600
GEOCODE_CACHE_MAX_ENTRIES=1000

# --- OTP --------------------------------------------------------------------
OTP_TTL_MINUTES=10
# Nombre d'essais de vérification par compte avant blocage temporaire.
OTP_MAX_ATTEMPTS=5
# Nombre de demandes d'envoi de code par IP et par fenêtre.
OTP_REQUEST_MAX=10
OTP_REQUEST_WINDOW_SECONDS=900
# Affiche le code OTP en console (développement uniquement, jamais en production).
OTP_DEBUG_DELIVERY=false

# --- pgAdmin (profil "tools") ----------------------------------------------
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=changez-moi

# --- Front -----------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
INTERNAL_API_URL=http://api:8000
